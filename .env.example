# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# 역할 분리 (token 모드에서는 세 URL이 서로 달라야 함)
# DATABASE_URL_QUERY=postgresql://query_ro:password@localhost:5432/dbname
# DATABASE_URL_MAP=postgresql://map_writer:password@localhost:5432/dbname
# DATABASE_URL_ADMIN=postgresql://data_admin:password@localhost:5432/dbname

# --- Security ---
# local: 루프백만 허용(기본). token: Bearer 토큰 + Host/Origin allowlist 필수
SECURITY_MODE=local
# API_USER_TOKEN=
# API_ADMIN_TOKEN=
# TRUSTED_HOSTS=127.0.0.1,localhost
# ALLOWED_ORIGINS=http://127.0.0.1:8000
# TRUST_PROXY_HEADERS=false
# SESSION_TTL_SECONDS=3600
# SESSION_MAX_COUNT=200
# MAX_QUESTION_CHARS=4000
# MAX_CONCURRENT_ASKS=4
# UPLOAD_CSV_MAX_BYTES=2000000
# UPLOAD_ZIP_MAX_BYTES=52428800
# UPLOAD_ZIP_MAX_ENTRIES=64
# UPLOAD_ZIP_MAX_UNCOMPRESSED=209715200
# LOG_SQL_IN_PRODUCTION=false
# ALLOW_REMOTE_OLLAMA_SAMPLES=false

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:latest
OLLAMA_EMBED_MODEL=mxbai-embed-large
SCHEMA_TOP_K=5
DEFAULT_LIMIT=100
EXAMPLE_TOP_K=3
SQL_MAX_RETRIES=3
USE_EXPLAIN=true
INCLUDE_SAMPLE_VALUES=true
# 의도 라우팅: rules | hybrid(기본·정확도 우선) | llm
INTENT_MODE=hybrid
INTENT_CONFIDENCE_THRESHOLD=0.55

# GeoServer (지도 시각화). URL이 비어 있으면 채팅만 동작한다.
# llm2_geodb와 같은 인스턴스를 쓸 때:
# GEOSERVER_URL=http://192.168.0.19:8080/geoserver
# GEOSERVER_USER=polemic
# GEOSERVER_PASSWORD=
# GEOSERVER_WORKSPACE=korDB
# GEOSERVER_DATASTORE=KoreaDB
# MAP_SCHEMA=public
# MAP_MAX_FEATURES=2000
# MAP_WFS_MAX_FEATURES=5000
# MAP_RETENTION_HOURS=24
# MAP_MAX_ANALYSIS_LAYERS=8

# Semantic Query Plan. off=기존과 동일, shadow=생성만, hybrid=실행 후 실패 시 RAG(기본)
SEMANTIC_PLAN_MODE=hybrid
SEMANTIC_PLAN_VERSION=1.1
SEMANTIC_PLAN_MAX_RETRIES=1
SEMANTIC_PLAN_MIN_QUALITY=0.85
SEMANTIC_PLAN_MIN_CONTRACT_COVERAGE=1.0
SEMANTIC_PLAN_MIN_SLOT_CONFIDENCE=0.85
SEMANTIC_PLAN_DEBUG=false

# 역할별 모델 pin. 공식 benchmark는 :latest 태그를 쓰지 않는다.
# OLLAMA_PLAN_MODEL=qwen3:500a1f067a9f
# OLLAMA_CHAT_MODEL=qwen3:500a1f067a9f
# OLLAMA_PLAN_DIGEST=500a1f067a9f7826
# OLLAMA_EMBED_DIGEST=468836162de7f81e
